# SHM 环境变量配置模板
# 使用方法: cp .env.example .env && 编辑 .env 填入你的 API Key
# 完整配置项参见 config/ 目录下各模块的配置类

# ─── 必填（至少一个推理后端） ───
DEEPSEEK_API_KEY=***

# ─── 可选推理后端 ───
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# ─── SHM 可选配置 ───
# SHM_LOG_LEVEL=INFO          # 日志级别: DEBUG/INFO/WARNING/ERROR
# SHM_API__HOST=0.0.0.0       # API 监听地址（Docker 部署保持 0.0.0.0）
# SHM_LLM_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
# SHM_LLM_MODEL=llama3
