[Unit]
Description=SHM — Self-evolving Hypergraph Memory
After=network.target
Wants=network.target

[Service]
Type=simple
User=admin
# 模板：部署时用 install.sh 安装，以下路径会被 INSTALL_DIR 替换
WorkingDirectory=/opt/shm
Environment="PATH=/opt/shm/.venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/opt/shm/.env
ExecStart=/opt/shm/.venv/bin/python run_server.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Resource limits
MemoryHigh=2G
MemoryMax=3G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
